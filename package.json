{
  "name": "@jonathanmorley/opencode-claude-compat",
  "version": "0.2.2",
  "type": "module",
  "description": "Minimal OpenCode plugin that bridges Claude Code plugins/marketplaces (skills, commands, agents, hooks, MCPs) — extracted from oh-my-openagent's claude-code-compat-core.",
  "license": "SUL-1.0",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./plugin": "./dist/plugin.js",
    "./v2": "./dist/v2.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanmorley/opencode-claude-compat.git"
  },
  "scripts": {
    "build": "bun build ./src/plugin.ts ./src/v2.ts --outdir ./dist --target bun --minify --external @opencode-ai/plugin",
    "test": "bun test",
    "test:harness": "bun run build && OPENCODE_HARNESS_TEST=1 bun test tests/harness.test.ts",
    "test:watch": "bun test --watch",
    "lint": "echo lint placeholder",
    "format": "echo format placeholder",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "dependencies": {
    "js-yaml": "^5.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@tsconfig/recommended": "1.0.13",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
